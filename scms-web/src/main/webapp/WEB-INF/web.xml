<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Protected SCMS APIs</web-resource-name>
            <url-pattern>/api/*</url-pattern>
        </web-resource-collection>
        
        <auth-constraint>
            <role-name>LOGISTICS_PERSONNEL</role-name>
            <role-name>VENDOR</role-name>
            <role-name>CUSTOMS_OFFICIAL</role-name>
        </auth-constraint>
    </security-constraint>
    
    <login-config>
        <auth-method>BASIC</auth-method>
        <realm-name>scmsRealm</realm-name>
    </login-config>
    
    <security-role>
        <role-name>LOGISTICS_PERSONNEL</role-name>
    </security-role>
    <security-role>
        <role-name>VENDOR</role-name>
    </security-role>
    <security-role>
        <role-name>CUSTOMS_OFFICIAL</role-name>
    </security-role>
    
</web-app>