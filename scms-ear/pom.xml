<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.nexcentauri</groupId>
        <artifactId>Global-Trade-Scms</artifactId>
        <version>1.0</version>
    </parent>
    <artifactId>scms-ear</artifactId>
    <packaging>ear</packaging>
    <dependencies>
        <dependency>
            <groupId>com.nexcentauri</groupId>
            <artifactId>scms-ejb</artifactId>
            <version>${project.version}</version>
            <type>ejb</type>
        </dependency>
        <dependency>
            <groupId>com.nexcentauri</groupId>
            <artifactId>scms-web</artifactId>
            <version>${project.version}</version>
            <type>war</type>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <version>10</version>
                    <defaultLibBundleDir>lib</defaultLibBundleDir>
                    <generateApplicationXml>false</generateApplicationXml>
                    <modules>
                        <ejbModule>
                            <groupId>com.nexcentauri</groupId>
                            <artifactId>scms-ejb</artifactId>
                            <bundleFileName>scms-ejb-1.0.jar</bundleFileName>
                        </ejbModule>
                        <webModule>
                            <groupId>com.nexcentauri</groupId>
                            <artifactId>scms-web</artifactId>
                            <bundleFileName>scms-web-1.0.war</bundleFileName>
                            <contextRoot>/Global-Trade-Scms</contextRoot>
                        </webModule>
                    </modules>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
